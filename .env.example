# WATCHTOWER runs fully keyless — every value below is OPTIONAL.
# Leave everything empty and the app uses: OSM imagery + ellipsoid terrain +
# self-extruded NYC building footprints, and the bundled FDNY-style audio file.

# Upgrade: Cesium World Terrain + OSM Buildings (free token at https://ion.cesium.com)
CESIUM_ION_TOKEN=

# Upgrade: Google Photorealistic 3D Tiles (takes precedence over ion if both set)
GOOGLE_MAPS_API_KEY=

# Upgrade: live FDNY dispatch audio (authenticated Broadcastify premium stream).
# Format: https://USERNAME:PASSWORD@audio.broadcastify.com/<feedId>.mp3
#   - USERNAME/PASSWORD are your broadcastify.com premium login
#   - URL-encode special characters in the password (@ -> %40, : -> %3A, etc.)
#   - FDNY Manhattan Dispatch is feed 46554
# Credentials stay server-side (the dashboard proxies audio via /api/audio/live).
# See README legal note — the bundled recording is the default and works offline.
BROADCASTIFY_URL=

# Upgrade: Prompt 15 voice command layer (fully optional — Tier A grammar +
# browser ASR work with no keys at all).
#   DEEPGRAM_API_KEY  streaming ASR with keyword boosting generated from the
#                     command grammar (console.deepgram.com). Without it the
#                     PTT falls back to the browser's native recognizer.
#   ANTHROPIC_API_KEY server-side Tier B intent fallback (a Haiku-class Claude
#                     picks ONE command from the closed schema, or no_match).
#                     Without it, unmatched transcripts show "didn't catch a
#                     command" and the deterministic grammar keeps working.
# PTT audio is never retained after transcription and never touches the radio
# transcription pipeline's retention rules.
DEEPGRAM_API_KEY=
ANTHROPIC_API_KEY=

# TAK server CoT endpoint (defaults match docker-compose: OpenTAKServer on host 8087).
# Only set these if your TAK server runs elsewhere.
TAK_HOST=
TAK_PORT=

# Parallel dev: two stacks (e.g. main checkout + a worktree) sharing the same
# Docker TAK server would publish identical simulated-unit uids and corrupt
# each other's picture, so each server namespaces its sim uids
# (WT-SIM-<ns>-E-6; drill units and shapes DRILL-<ns>-…) and ignores foreign
# namespaces at ingest. The namespace
# defaults to the server's port (from the WATCHTOWER_SERVER_PORT process env
# var; 4010 if unset), which is already unique per running stack — set this
# only to pin a namespace explicitly.
WATCHTOWER_SIM_NS=
