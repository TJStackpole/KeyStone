# WATCHTOWER runs fully keyless — every value below is OPTIONAL.
# Leave everything empty and the app uses: OSM imagery + ellipsoid terrain +
# self-extruded NYC building footprints, and the bundled FDNY-style audio file.

# Upgrade: Cesium World Terrain + OSM Buildings (free token at https://ion.cesium.com)
CESIUM_ION_TOKEN=

# Upgrade: Google Photorealistic 3D Tiles (takes precedence over ion if both set)
GOOGLE_MAPS_API_KEY=

# Upgrade: live FDNY dispatch audio (authenticated Broadcastify premium stream URL).
# See README legal note — the bundled recording is the default and works offline.
BROADCASTIFY_URL=

# TAK server CoT endpoint (defaults match docker-compose: OpenTAKServer on host 8087).
# Only set these if your TAK server runs elsewhere.
TAK_HOST=
TAK_PORT=
